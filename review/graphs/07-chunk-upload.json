              "~share.js:669-695"
            ],
            "phase": 2
          },
          {
            "id": "read",
            "type": "dec",
            "text": [
              "7. Stück lesbar?",
              "~chunk_handler.go:60-90",
              "MaxPostSize als Speichergrenze"
